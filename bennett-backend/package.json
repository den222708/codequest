{
  "name": "bennett-backend",
  "version": "1.0.0",
  "description": "Bennett CodeQuest backend — Hono + Supabase + Programiz proxy",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@sentry/node": "^10.43.0",
    "@supabase/supabase-js": "^2.49.0",
    "dotenv": "^16.4.0",
    "hono": "^4.7.0",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "2.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
